  size?: 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'full' | 'shield-only' | 'badge';
  showText?: boolean;
}

export const SchoolLogo: React.FC<SchoolLogoProps> = ({
  className = '',
  size = 'md',
  variant = 'full',
  showText = true
