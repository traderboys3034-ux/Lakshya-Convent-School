  const sizeClasses = {
    sm: 'w-8 h-8',
    md: 'w-11 h-11',
    lg: 'w-16 h-16',
    xl: 'w-24 h-24'
  };

  if (variant === 'badge') {
    return (
      <div className={`flex items-center gap-3 ${className}`}>
        <div className={`${sizeClasses[size]} shrink-0 rounded-xl bg-gradient-to-tr from-blue-900 via-blue-700 to-amber-500 p-0.5 shadow-lg relative group`}>
          <div className="w-full h-full bg-white rounded-[10px] flex items-center justify-center p-1 relative overflow-hidden">
            <img src="images/logo.png" alt="Laksya Convent School Logo" className="w-full h-full object-contain rounded-[8px]" />
          </div>
        </div>

        {showText && (
          <div>
            <div className="text-lg md:text-xl font-black tracking-tight text-white flex items-center gap-1.5 font-sans">
              <span>Laksya Convent School</span>
            </div>
            <div className="text-xs font-bold text-amber-400 tracking-wider">
              लक्ष्य कॉन्वेंट स्कूल
            </div>
          </div>
        )}
      </div>
    );
  }

  // Full Emblem component displaying official logo image
  return (
    <div className={`flex flex-col items-center text-center ${className}`}>
      <div className="w-28 h-28 rounded-2xl overflow-hidden border-2 border-amber-400 p-1.5 bg-white shadow-xl mx-auto flex items-center justify-center">
        <img src="images/logo.png" alt="Laksya Convent School Emblem" className="w-full h-full object-contain" />
      </div>

      {showText && (
        <div className="mt-3 space-y-0.5">
          <h2 className="text-xl font-black tracking-tight text-slate-900 dark:text-white">
            LAKSYA CONVENT SCHOOL
          </h2>
          <p className="text-xs font-bold text-amber-500 tracking-wider">
            लक्ष्य कॉन्वेंट स्कूल, राजाउली
          </p>
          <p className="text-[10px] font-semibold text-slate-500 dark:text-slate-400 tracking-widest uppercase mt-0.5">
            LEARN • LEAD • SUCCEED
          </p>
        </div>
